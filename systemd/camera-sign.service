[Unit]
Description=Light the on-air sign while the webcam is in use
Documentation=https://github.com/pillarsdotnet/camera-sign

[Service]
EnvironmentFile=%h/.config/camera-sign/env
ExecStart=%h/.local/bin/camera-sign watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
