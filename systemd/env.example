# Copy to ~/.config/camera-sign/env and set the plug's address.
CAMERA_SIGN_HOST=192.168.1.50
# Only newer Kasa firmware needs your TP-Link account; leave these unset otherwise.
#CAMERA_SIGN_USERNAME=you@example.com
#CAMERA_SIGN_PASSWORD=secret
